services:
  server:
    build:
      context: ./server
      dockerfile: Dockerfile
    ports:
      - "3000:8050"
    environment:
        - API_PORT=8050
        - DB_NAME=
        - DB_USER=
        - DB_PASSWORD=
        - DB_HOST=
        - DB_DIALECT=mysql
        - DB_PORT=25060
        - DB_SSL=false

